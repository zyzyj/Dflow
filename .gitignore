# Dependencies
node_modules/

# Runtime and Local User Data
data/

# OS & Editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Local prompt scratch files and secrets
temp_prompt_*.txt
.env
.env.*
!.env.example
*.key
*.pem
*.token

# Generated one-off reverse/automation scratch files
temp_auto_*.txt
ANTIGRAVITY_DFLOW_REFACTOR_GUIDE.md

# Publish only these built-in expansion presets; all other local files stay private.
presets/*
!presets/通用扩写.txt
!presets/插画.txt
!presets/电影.txt
!presets/海报.txt
!presets/巨构提示词.txt

# Android build output
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/app/release/

# Binaries fetched by CI and copied into the Android project. They are large
# and architecture-specific, so they are rebuilt on every run instead of
# being committed.
android/app/src/main/jniLibs/
android/app/src/main/assets/

# Scratch directories used while assembling the APK
rootfs/
app-assets/
